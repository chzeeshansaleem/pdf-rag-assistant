generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

model Document {
  id           String         @id @default(uuid())
  filename     String
  fileSize     Int
  pageCount    Int            @default(0)
  chunkCount   Int            @default(0)
  status       DocumentStatus @default(QUEUED)
  category     String?        @db.VarChar(50)
  storagePath  String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([category])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  // Rolling summary of messages older than the "recent window" sent to the
  // LLM — see ConversationsService.maybeSummarize. Keeps long conversations
  // from growing the prompt unboundedly while still preserving earlier
  // context (documents discussed, entities, unresolved references).
  summary   String?
  // Id of the newest message already folded into `summary`, so
  // maybeSummarize() only has to summarize messages that aged out of the
  // recent window since the last run, not the whole prefix again each time.
  summarizedThroughMessageId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  scopeDocumentIds String[]     @default([])
  scopeCategory    String?
  createdAt        DateTime     @default(now())

  sources MessageSource[]

  @@index([conversationId, createdAt])
}

model MessageSource {
  id          String  @id @default(uuid())
  messageId   String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId  String
  filename    String
  pageNumber  Int
  chunkIndex  Int
  snippetText String

  @@index([messageId])
  @@index([documentId])
}
