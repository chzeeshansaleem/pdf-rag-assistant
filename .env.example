# ──────────────────────────────────────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Chat/completion model used to generate grounded answers
OPENAI_CHAT_MODEL=gpt-4o-mini
# Embedding model used to vectorize chunks and questions
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ──────────────────────────────────────────────────────────────────────────
# Qdrant (vector database)
# ──────────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_documents

# ──────────────────────────────────────────────────────────────────────────
# Chunking
# ──────────────────────────────────────────────────────────────────────────
# Approximate chunk size in tokens
CHUNK_SIZE=700
# Approximate overlap between consecutive chunks in tokens
CHUNK_OVERLAP=120

# ──────────────────────────────────────────────────────────────────────────
# Retrieval-Augmented Generation
# ──────────────────────────────────────────────────────────────────────────
# Number of chunks to retrieve per question
RAG_TOP_K=5
# Minimum cosine similarity score (0-1) for a chunk to be considered relevant.
# Chunks below this threshold are discarded before hitting the LLM, which is
# the primary defense against hallucination on out-of-document questions.
RAG_SIMILARITY_THRESHOLD=0.35

# ──────────────────────────────────────────────────────────────────────────
# Uploads
# ──────────────────────────────────────────────────────────────────────────
# Maximum PDF upload size in bytes (default: 20 MB)
MAX_FILE_SIZE=20971520

# ──────────────────────────────────────────────────────────────────────────
# Database (optional — document metadata only, never the PDF binary)
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/pdf_rag_agent

# ──────────────────────────────────────────────────────────────────────────
# Backend server
# ──────────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed frontend origins (Vite falls back to 5174,
# 5175, ... if 5173 is already taken)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ──────────────────────────────────────────────────────────────────────────
# Frontend (Vite — must be prefixed with VITE_ to be exposed to the client)
# ──────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
